# Dagster webserver (start with: uv run dagster dev -p "$DAGSTER_PORT")
DAGSTER_HOST=127.0.0.1
DAGSTER_PORT=3000
DAGSTER_LOCATION_NAME=mock_io_app
# DAGSTER_HOME must be absolute and .env doesn't expand variables; omit it for a temp dir,
# or run: mkdir -p .dagster_home && export DAGSTER_HOME="$PWD/.dagster_home"

# API server and CLI client
MOCK_IO_API_HOST=127.0.0.1
MOCK_IO_API_PORT=8002
MOCK_IO_API_URL=http://127.0.0.1:8002

# Scenarios
MOCK_IO_SCENARIO_DIR=scenarios
MOCK_IO_SCENARIO_GLOB=*.yaml

# Tracing: none | console | otlp
MOCK_IO_TRACE_EXPORTER=none
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4317
OTEL_EXPORTER_OTLP_PROTOCOL=grpc
